<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- For the Pomodoro timer's ongoing notification (API 33+ requires this at runtime too). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Saved links fetch the title of a pasted or shared page. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- For the Reader's playback foreground service (API 34+). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!--
        Package visibility (Android 11+) for the Custom Tabs host. Launching a
        link works without this, but anything that inspects browsers — warmup,
        sessions, "is a Custom Tab available" — needs to see them.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Blogmark"
        android:supportsRtl="true"
        android:theme="@style/Theme.Blogmark.Splash">

        <!--
            singleTask so a share reuses the running app instead of stacking a
            second copy of it. With the default `standard` mode, sharing a link
            builds a fresh MainActivity — and with it a second Compose tree
            holding its own copy of the saved-link library — so the link was
            saved into an instance that was not the one on screen, and the
            visible list never showed it. There is only ever one of this
            activity; onNewIntent is where a share now arrives.
        -->
        <activity
            android:name="dev.mks.blogmark.android.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize">

            <!--
                Share target: "Share -> Blogmark" from a browser or any app that
                sends text. Chrome sends the page URL as EXTRA_TEXT, often with
                the title in front of it, which is why the handler extracts the
                link rather than storing the payload whole.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
            The launcher entry point lives on these two aliases rather than on
            MainActivity itself, because icon and splash theme both work at
            the manifest/component level, not at runtime inside one activity:
            an activity-alias can carry its own android:icon and android:theme
            that override the target activity's for that particular launch.
            Exactly one is enabled at a time — PlatformThemeIcon flips them
            with PackageManager.setComponentEnabledSetting whenever the
            in-app theme toggle changes, DONT_KILL_APP so it never disturbs
            a running session. LauncherPaper starts enabled to match
            UserPrefs' default (mono = false).
        -->
        <activity-alias
            android:name="dev.mks.blogmark.android.LauncherPaper"
            android:targetActivity="dev.mks.blogmark.android.MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="Blogmark"
            android:theme="@style/Theme.Blogmark.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="dev.mks.blogmark.android.LauncherInk"
            android:targetActivity="dev.mks.blogmark.android.MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_ink"
            android:roundIcon="@mipmap/ic_launcher_round_ink"
            android:label="Blogmark"
            android:theme="@style/Theme.Blogmark.Splash.Ink">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!--
            No official foreground-service type fits a countdown timer, so this
            uses "specialUse" (API 34+) with the required justification below;
            harmless no-op on older versions where the type is not enforced.
        -->
        <service
            android:name="dev.mks.blogmark.pomodoro.PomodoroService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Focus/Pomodoro session timer" />
        </service>

        <!-- Reader playback: a real foreground-service type exists for this one. -->
        <service
            android:name="dev.mks.blogmark.reader.ReaderPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>

</manifest>
