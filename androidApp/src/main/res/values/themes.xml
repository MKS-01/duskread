<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The launch theme. Android shows this from the moment the process starts,
        so it costs nothing — unlike a splash drawn in Compose, which can only
        appear once there is a first frame, and so would add to startup rather
        than cover it.

        The icon animates (the meter's bars settling — see
        ic_duskread_splash_ink), but nothing here imposes a delay: the
        duration below only tells the system how long the animation runs, and
        the window is still dismissed the moment the app has something to
        draw. On a warm start that cuts the settle off part-way through,
        which is the right trade — the splash is there to cover a wait, not
        to make one.

        ".Ink" in the name is a holdover from when a second, terracotta pair
        existed alongside it and the app picked between them at runtime — see
        AndroidManifest.xml. The app icon is Ink's only now, but the name
        stayed rather than forcing a rename through the manifest and every
        resource file that points at it.
    -->
    <style name="Theme.DuskRead.Splash.Ink" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background_ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_duskread_splash_ink</item>
        <item name="windowSplashScreenAnimationDuration">700</item>
        <item name="postSplashScreenTheme">@style/Theme.DuskRead.Ink</item>
    </style>

    <style name="Theme.DuskRead.Ink" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/splash_background_ink</item>
    </style>
</resources>
