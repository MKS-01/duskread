<!-- The one shape settles to rest, scaling up rather than fading in —
     the same idea as the old bars-settling splash, with one shape instead
     of three to stagger. -->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="380"
    android:interpolator="@android:interpolator/decelerate_quint"
    android:propertyName="scaleY"
    android:startOffset="40"
    android:valueFrom="0.08"
    android:valueTo="1"
    android:valueType="floatType" />
