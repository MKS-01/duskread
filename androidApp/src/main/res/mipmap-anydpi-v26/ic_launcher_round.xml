<?xml version="1.0" encoding="utf-8"?>
<!--
    Foreground is `ic_blogmark_mark` itself rather than a copy of it: the
    launcher icon and the launch animation have to be the same mark, and the
    surest way to keep them that way is for there to be only one of it.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_blogmark_mark" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
