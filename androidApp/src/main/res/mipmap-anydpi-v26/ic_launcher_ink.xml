<?xml version="1.0" encoding="utf-8"?>
<!-- Ink's launcher icon — same structure as ic_launcher.xml, pointed at the
     Ink background/foreground pair. The Android 13+ themed-icon layer is
     shared: it's already a flattened silhouette the system tints itself, so
     it needs no Ink-specific copy. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background_ink" />
    <foreground android:drawable="@drawable/ic_launcher_foreground_ink" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
