<!--
    Ink's copy of the mark: same geometry as ic_duskread_mark, filled with
    Ink's lightest ink (MonoScheme.primary, #DCDCDC) instead of terracotta,
    and the bite painted in Ink's own ground (#161616, MonoScheme.background)
    rather than Paper Black's — the launcher icon and splash need to drop
    colour the same way the in-app scheme does when a reader switches to Ink.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:name="mark"
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.85"
        android:scaleY="0.85">

        <group
            android:name="bar_main"
            android:pivotX="54"
            android:pivotY="54">
            <path
                android:fillColor="#DCDCDC"
                android:pathData="M40,38 a14,14 0 0 1 28,0 v36 a14,14 0 0 1 -28,0 z" />
            <path
                android:fillColor="#161616"
                android:pathData="M44,32 a16,16 0 0 1 32,0 a16,16 0 0 1 -32,0 z" />
        </group>
    </group>
</vector>
