<!--
    The mark: a bookmark ribbon inside the same lens ring the app has always
    used — the ring is the reading idea (attention closing in on one thing),
    the ribbon inside names the app itself, the two together say "Blogmark"
    rather than "a generic reader". See ui/theme/Theme.kt for the palette
    these come from.

    Sized for the Android 12+ splash icon: 108dp canvas with the artwork
    inside the safe centre (the outer third is masked away).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Stroked rather than two filled circles so the ring stays one path and
         the weight is tunable in one number. -->
    <path
        android:strokeColor="#C6684A"
        android:strokeWidth="4.5"
        android:pathData="M31,54 A23,23 0 1 1 77,54 A23,23 0 1 1 31,54 Z" />

    <path
        android:fillColor="#E8E6E2"
        android:pathData="M47,40 L61,40 L61,66 L54,58 L47,66 Z" />
</vector>
