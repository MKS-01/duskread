        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M35,34.5 a4.5,4.5 0 0 1 9,0 v39 a4.5,4.5 0 0 1 -9,0 z" />
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M50,24 h20 a3,3 0 0 1 3,3 v57 l-13,-10 l-13,10 V27 a3,3 0 0 1 3,-3 z" />
