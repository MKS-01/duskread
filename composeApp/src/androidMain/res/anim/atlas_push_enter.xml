<?xml version="1.0" encoding="utf-8"?>
<!--
    Mirrors the in-app push in App.kt: slideInHorizontally { it / 3 } + fadeIn.
    A reference opens the way a topic does, so the Custom Tab reads as the next
    screen rather than a hand-off to the browser.
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/fast_out_slow_in">
    <translate
        android:fromXDelta="33%p"
        android:toXDelta="0%p"
        android:duration="260" />
    <alpha
        android:fromAlpha="0.0"
        android:toAlpha="1.0"
        android:duration="200" />
</set>
